import json
from typing import Dict, Any

import pandas as pd
import joblib
from kafka import KafkaConsumer

# CONFIG
KAFKA_TOPIC = "transactions"
KAFKA_SERVER = "localhost:9092"
MODEL_PATH = "models/model.pkl"

BATCH_SIZE = 32

# LOAD MODEL 
model = joblib.load(MODEL_PATH)
FEATURE_COLUMNS = None


# PREPROCESS 
def preprocess(tx: Dict[str, Any]) -> pd.DataFrame:
    df = pd.DataFrame([tx])

 
    drop_cols = ["event_time", "drift_status"]
    for col in drop_cols:
        if col in df.columns:
            df.drop(columns=col, inplace=True)

    # convertir object -> numérique
    for col in df.select_dtypes(include=["object"]).columns:
        df[col] = df[col].astype("category").cat.codes

    # remplacer NaN
    df.fillna(0, inplace=True)

    return df


# SCORING
def score_transaction(tx: Dict[str, Any]) -> Dict[str, Any]:
    try:
        df = preprocess(tx)

        global FEATURE_COLUMNS

        # première fois → mémoriser colonnes
        if FEATURE_COLUMNS is None:
            FEATURE_COLUMNS = df.columns

        # aligner colonnes
        df = df.reindex(columns=FEATURE_COLUMNS, fill_value=0)

        score = model.predict_proba(df)[0][1]

        return {
            "transaction_id": tx.get("transaction_id"),
            "amount": tx.get("amount"),
            "score": float(score),
            "is_fraud": score > 0.8
        }

    except Exception as e:
        print(f"ERROR: {e}")

        return {
            "transaction_id": tx.get("transaction_id"),
            "amount": tx.get("amount"),
            "score": 0.5,
            "is_fraud": False
        }


# CONSUMER
def main():
    consumer = KafkaConsumer(
        KAFKA_TOPIC,
        bootstrap_servers=KAFKA_SERVER,
        value_deserializer=lambda x: json.loads(x.decode("utf-8")),
        auto_offset_reset="earliest",
        enable_auto_commit=True,
        group_id="fraud-consumer"
    )

    print(" Consumer started...")

    batch = []
    total = 0

    try:
        for message in consumer:
            tx = message.value
            batch.append(tx)

            if len(batch) >= BATCH_SIZE:
                for tx in batch:
                    result = score_transaction(tx)

                    if result["is_fraud"]:
                        print(f"⚠️ FRAUD: {result}")
                    else:
                        print(f"OK: {result}")

                total += len(batch)
                print(f"Batch processed: {len(batch)} | Total: {total}")

                batch = []

    except KeyboardInterrupt:
        print("\n Stopped manually")
        print(f"Total processed: {total}")


if __name__ == "__main__":
    main()
