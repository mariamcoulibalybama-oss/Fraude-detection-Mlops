# ============================================================
# Variables d'environnement pour le projet
# Copier ce fichier en .env et adapter les valeurs
# ============================================================

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASSWORD=changeme
MONGO_DB=fraude

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_ALERTS=alerts

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=fraud_detection

# --- Producer config ---
TRANSACTIONS_PER_SECOND=10
INJECT_DRIFT_AFTER_MINUTES=30

# --- Model config ---
MODEL_NAME=fraud_xgboost
MODEL_STAGE=Production
FRAUD_THRESHOLD=0.5

# --- Logs ---
LOG_LEVEL=INFO
